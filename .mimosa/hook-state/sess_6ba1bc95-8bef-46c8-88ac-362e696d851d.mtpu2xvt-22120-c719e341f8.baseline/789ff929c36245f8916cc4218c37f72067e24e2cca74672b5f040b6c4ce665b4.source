import "./server.js";
//#region src/lib/stores/toast.svelte.ts
var toasts = [];
var nextId = 0;
function getToasts() {
	return toasts;
}
function pushToast(message, type = "info") {
	const id = nextId++;
	toasts.push({
		id,
		type,
		message
	});
	setTimeout(() => dismissToast(id), 4e3);
}
function dismissToast(id) {
	const index = toasts.findIndex((t) => t.id === id);
	if (index !== -1) toasts.splice(index, 1);
}
//#endregion
export { pushToast as n, getToasts as t };
