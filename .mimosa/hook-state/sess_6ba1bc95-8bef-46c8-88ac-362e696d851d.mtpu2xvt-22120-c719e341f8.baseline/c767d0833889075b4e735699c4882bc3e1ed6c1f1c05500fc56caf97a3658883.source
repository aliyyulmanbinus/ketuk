function e(e){return new Intl.DateTimeFormat(`id-ID`,{weekday:`long`,day:`numeric`,month:`long`,year:`numeric`,timeZone:`Asia/Jakarta`}).format(new Date(e))}function t(e){let[t,n]=e.split(`:`);return`${t}.${n} WIB`}function n(e){let t=new Date(e).getTime()-Date.now();return t<=0?{days:0,hours:0,minutes:0,seconds:0,isPast:!0}:{days:Math.floor(t/864e5),hours:Math.floor(t/36e5%24),minutes:Math.floor(t/6e4%60),seconds:Math.floor(t/1e3%60),isPast:!1}}export{t as n,n as r,e as t};