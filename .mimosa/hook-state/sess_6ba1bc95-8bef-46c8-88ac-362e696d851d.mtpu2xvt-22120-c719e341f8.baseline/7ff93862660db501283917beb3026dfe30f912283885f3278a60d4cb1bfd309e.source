import { S as attr, c as store_get, l as stringify, o as head, u as unsubscribe_stores, w as escape_html } from "../../../../../chunks/server.js";
import { a as Input, i as Modal, s as Button } from "../../../../../chunks/Textarea.js";
import "../../../../../chunks/ui.js";
import { n as pushToast } from "../../../../../chunks/toast.svelte.js";
import { t as invalidateAll } from "../../../../../chunks/client.js";
import { t as page } from "../../../../../chunks/stores.js";
import "../../../../../chunks/navigation.js";
import { i as deleteChecklistItem, l as updateChecklistItem } from "../../../../../chunks/api.js";
import { o as ChecklistList } from "../../../../../chunks/domain.js";
//#region src/routes/(app)/planner/checklist/+page.svelte
function _page($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		var $$store_subs;
		let { data } = $$props;
		let modalOpen = false;
		let title = "";
		let submitting = false;
		async function handleToggle(item) {
			try {
				await updateChecklistItem(data.eventId, item.id, { isDone: !item.isDone }, { accessToken: store_get($$store_subs ??= {}, "$page", page).data.accessToken });
				await invalidateAll();
			} catch {
				pushToast("Gagal mengubah status.", "error");
			}
		}
		async function handleDelete(item) {
			try {
				await deleteChecklistItem(data.eventId, item.id, { accessToken: store_get($$store_subs ??= {}, "$page", page).data.accessToken });
				await invalidateAll();
			} catch {
				pushToast("Gagal menghapus item.", "error");
			}
		}
		let $$settled = true;
		let $$inner_renderer;
		function $$render_inner($$renderer) {
			head("t3yvct", $$renderer, ($$renderer) => {
				$$renderer.title(($$renderer) => {
					$$renderer.push(`<title>Checklist — Ketuk.id</title>`);
				});
			});
			$$renderer.push(`<div class="flex items-center justify-between"><div><h1 class="font-display text-2xl font-bold text-navy-900">Checklist</h1> <a${attr("href", `/planner?event=${stringify(data.eventId)}`)} class="text-sm text-navy-400 hover:text-navy-700">← Kembali ke Planner</a></div> `);
			Button($$renderer, {
				onclick: () => modalOpen = true,
				children: ($$renderer) => {
					$$renderer.push(`<!---->Tambah Item`);
				},
				$$slots: { default: true }
			});
			$$renderer.push(`<!----></div> <div class="mt-6">`);
			if (data.error) $$renderer.push(`<!--[0--><p class="rounded-lg bg-red-50 p-4 text-sm text-red-600">${escape_html(data.error)}</p>`);
			else {
				$$renderer.push("<!--[-1-->");
				ChecklistList($$renderer, {
					items: data.items,
					onToggle: handleToggle,
					onDelete: handleDelete
				});
			}
			$$renderer.push(`<!--]--></div> `);
			Modal($$renderer, {
				open: modalOpen,
				title: "Tambah Item Checklist",
				onclose: () => modalOpen = false,
				children: ($$renderer) => {
					$$renderer.push(`<form class="flex flex-col gap-4">`);
					Input($$renderer, {
						label: "Judul item",
						required: true,
						get value() {
							return title;
						},
						set value($$value) {
							title = $$value;
							$$settled = false;
						}
					});
					$$renderer.push(`<!----> `);
					Button($$renderer, {
						type: "submit",
						loading: submitting,
						children: ($$renderer) => {
							$$renderer.push(`<!---->Tambah`);
						},
						$$slots: { default: true }
					});
					$$renderer.push(`<!----></form>`);
				},
				$$slots: { default: true }
			});
			$$renderer.push(`<!---->`);
		}
		do {
			$$settled = true;
			$$inner_renderer = $$renderer.copy();
			$$render_inner($$inner_renderer);
		} while (!$$settled);
		$$renderer.subsume($$inner_renderer);
		if ($$store_subs) unsubscribe_stores($$store_subs);
	});
}
//#endregion
export { _page as default };
