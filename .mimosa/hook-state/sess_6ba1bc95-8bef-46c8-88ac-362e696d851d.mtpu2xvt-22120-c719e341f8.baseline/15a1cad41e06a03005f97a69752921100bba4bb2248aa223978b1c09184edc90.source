		}
		let wishes = [];
		let wishesLoading = true;
		async function loadWishes() {
			wishesLoading = true;
			try {
				wishes = await listWishes(event.slug);
			} catch {
				wishes = [];
			} finally {
				wishesLoading = false;
			}
