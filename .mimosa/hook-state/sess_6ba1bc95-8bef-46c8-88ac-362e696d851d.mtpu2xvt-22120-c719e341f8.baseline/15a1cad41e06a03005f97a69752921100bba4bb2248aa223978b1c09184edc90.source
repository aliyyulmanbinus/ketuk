//#region src/lib/components/domain/PlanCard.svelte
function PlanCard($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { plan, highlighted = false } = $$props;
		$$renderer.push(`<div${attr_class(`flex flex-col gap-6 rounded-2xl border p-8 ${highlighted ? "border-coral-500 bg-navy-900 text-white shadow-xl" : "border-navy-100 bg-white"}`)}><div><h3 class="font-display text-xl font-bold">${escape_html(plan.name)}</h3> <p${attr_class(`mt-1 text-sm ${highlighted ? "text-white/70" : "text-navy-500"}`)}>${escape_html(plan.description)}</p></div> <p class="font-display text-3xl font-bold">${escape_html(plan.price === 0 ? "Gratis" : formatRupiah(plan.price))} `);
		if (plan.price > 0) $$renderer.push(`<!--[0--><span${attr_class(`text-sm font-normal ${highlighted ? "text-white/60" : "text-navy-400"}`)}>/acara</span>`);
		else $$renderer.push("<!--[-1-->");
		$$renderer.push(`<!--]--></p> <ul class="flex flex-1 flex-col gap-2.5 text-sm"><!--[-->`);
		const each_array = ensure_array_like(plan.features);
		for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
			let feature = each_array[$$index];
			$$renderer.push(`<li${attr_class(`flex items-center gap-2 ${feature.included ? "" : highlighted ? "text-white/40" : "text-navy-300"}`)}><span aria-hidden="true">${escape_html(feature.included ? "✓" : "–")}</span> ${escape_html(feature.label)}</li>`);
		}
		$$renderer.push(`<!--]--></ul> `);
		Button($$renderer, {
			variant: highlighted ? "primary" : "secondary",
			href: "/daftar",
			fullWidth: true,
			children: ($$renderer) => {
				$$renderer.push(`<!---->${escape_html(plan.price === 0 ? "Mulai Gratis" : "Pilih Paket")}`);
			},
			$$slots: { default: true }
		});
		$$renderer.push(`<!----></div>`);
	});
}
