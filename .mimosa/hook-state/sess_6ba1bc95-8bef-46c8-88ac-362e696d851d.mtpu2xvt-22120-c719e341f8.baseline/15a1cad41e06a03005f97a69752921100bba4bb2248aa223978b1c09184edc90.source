		const config = derived(() => EVENT_TYPE_CONFIGS.find((c) => c.value === event.type));
		const displayNames = derived(() => {
			if (invitation()) {
				if (isWeddingLike() && "groomName" in invitation() && invitation().groomName && invitation().brideName) return `${invitation().brideName} & ${invitation().groomName}`;
				if ("hostName" in invitation() && invitation().hostName) return invitation().hostName;
			}
			return event.title;
		});
		const bankAccount = derived(() => {
			const raw = invitation()?.customData?.["bankAccount"];
			if (raw && typeof raw === "object" && "bank" in raw && "accountNumber" in raw && "accountName" in raw) return raw;
			return null;
		});
