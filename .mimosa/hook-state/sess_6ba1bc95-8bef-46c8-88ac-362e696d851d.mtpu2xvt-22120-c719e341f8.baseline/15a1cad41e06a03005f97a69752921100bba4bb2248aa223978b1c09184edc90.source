			value: m.code,
			label: m.label
		}));
		function openOrderModal(product) {
			orderModalProduct = product;
			orderResult = null;
			orderError = "";
		}
		let $$settled = true;
		let $$inner_renderer;
		function $$render_inner($$renderer) {
			if (invitation()?.musicUrl) $$renderer.push(`<!--[0--><audio${attr("src", invitation().musicUrl)} loop=""></audio>`);
			else $$renderer.push("<!--[-1-->");
			$$renderer.push(`<!--]--> `);
			if (coverOpen) {
				$$renderer.push(`<!--[0--><div class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-6 bg-navy-900 px-6 text-center text-white"><p class="text-sm text-white/60">${escape_html(config()?.emoji ?? "✨")} ${escape_html(config()?.label ?? "")}</p> <h1 class="font-display text-3xl font-bold sm:text-4xl">${escape_html(displayNames())}</h1> `);
