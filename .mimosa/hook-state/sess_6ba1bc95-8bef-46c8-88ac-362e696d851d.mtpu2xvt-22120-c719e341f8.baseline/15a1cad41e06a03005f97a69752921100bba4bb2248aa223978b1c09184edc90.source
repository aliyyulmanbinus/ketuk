//#region src/lib/components/domain/VendorCard.svelte
function VendorCard($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { vendor } = $$props;
		const config = derived(() => VENDOR_CATEGORY_CONFIGS.find((c) => c.value === vendor.category));
		$$renderer.push(`<a${attr("href", `/vendor/${stringify(vendor.slug)}`)} class="flex flex-col gap-3 rounded-xl border border-navy-100 bg-white p-5 transition-shadow hover:shadow-md"><div class="flex items-start justify-between gap-2"><div><p class="text-2xl" aria-hidden="true">${escape_html(config()?.emoji ?? "🏷️")}</p> <h3 class="mt-1 font-display text-lg font-semibold text-navy-900">${escape_html(vendor.name)}</h3> <p class="text-sm text-navy-500">${escape_html(config()?.label ?? vendor.category)} · ${escape_html(vendor.city ?? "Lokasi belum diatur")}</p></div> `);
		if (vendor.isVerified) {
			$$renderer.push("<!--[0-->");
			Badge($$renderer, {
				tone: "vendor",
				children: ($$renderer) => {
					$$renderer.push(`<!---->Terverifikasi`);
				},
				$$slots: { default: true }
			});
		} else $$renderer.push("<!--[-1-->");
		$$renderer.push(`<!--]--></div> <p class="text-sm text-navy-700">${escape_html(formatRupiah(vendor.priceMin))} – ${escape_html(formatRupiah(vendor.priceMax))}</p> <p class="text-xs text-navy-400">⭐ ${escape_html(vendor.rating.toFixed(1))} (${escape_html(vendor.reviewCount)} ulasan)</p></a>`);
	});
}
