import { S as attr, a as ensure_array_like, c as store_get, t as attr_class, u as unsubscribe_stores, w as escape_html } from "../../../chunks/server.js";
import { t as page } from "../../../chunks/stores.js";
import "../../../chunks/navigation.js";
import { t as createSupabaseBrowserClient } from "../../../chunks/client2.js";
