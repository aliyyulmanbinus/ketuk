			$$renderer.push(`<a${attr("href", item.href)}${attr_class(`flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium ${store_get($$store_subs ??= {}, "$page", page).url.pathname.startsWith(item.href) ? "bg-coral-100 text-coral-600" : "text-navy-600 hover:bg-navy-50"}`)}><span aria-hidden="true">${escape_html(item.icon)}</span> ${escape_html(item.label)}</a>`);
		}
		$$renderer.push(`<!--]--></nav> <div class="mt-auto flex flex-col gap-2 border-t border-navy-100 pt-4"><p class="truncate text-xs text-navy-400">${escape_html(data.user.email)}</p> <button type="button" class="text-left text-sm font-medium text-navy-500 hover:text-navy-900">Keluar</button></div></aside> <div class="flex flex-1 flex-col"><header class="flex items-center justify-between border-b border-navy-100 bg-white px-4 py-3 lg:hidden"><a href="/dashboard" class="font-display text-lg font-bold text-navy-900">Ketuk<span class="text-coral-500">.id</span></a> <button type="button" aria-label="Buka menu navigasi"${attr("aria-expanded", mobileOpen)} class="text-2xl">☰</button></header> `);
