import { S as attr, a as ensure_array_like, i as derived, l as stringify, o as head, u as unsubscribe_stores, w as escape_html } from "../../../../../chunks/server.js";
import { a as Input, i as Modal, o as EmptyState, s as Button } from "../../../../../chunks/Textarea.js";
import "../../../../../chunks/ui.js";
import "../../../../../chunks/toast.svelte.js";
import "../../../../../chunks/stores.js";
import "../../../../../chunks/navigation.js";
import "../../../../../chunks/api.js";
//#region src/routes/(app)/planner/timeline/+page.svelte
function _page($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		var $$store_subs;
		let { data } = $$props;
		let modalOpen = false;
		let title = "";
		let time = "08:00";
		let pic = "";
		let submitting = false;
		const sortedItems = derived(() => [...data.items].sort((a, b) => a.time.localeCompare(b.time)));
		let $$settled = true;
		let $$inner_renderer;
		function $$render_inner($$renderer) {
			head("3zvjgi", $$renderer, ($$renderer) => {
				$$renderer.title(($$renderer) => {
					$$renderer.push(`<title>Timeline — Ketuk.id</title>`);
				});
