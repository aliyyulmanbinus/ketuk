				title: "Tambah Item Rundown",
				onclose: () => modalOpen = false,
				children: ($$renderer) => {
					$$renderer.push(`<form class="flex flex-col gap-4">`);
					Input($$renderer, {
						label: "Judul kegiatan",
						required: true,
						get value() {
							return title;
						},
						set value($$value) {
							title = $$value;
							$$settled = false;
						}
					});
					$$renderer.push(`<!----> `);
					Input($$renderer, {
						label: "Jam",
						type: "time",
						required: true,
						get value() {
							return time;
						},
						set value($$value) {
							time = $$value;
							$$settled = false;
						}
