			$$renderer.push(`<h1 class="font-display text-xl font-semibold text-navy-900">Mulai gratis</h1> <p class="mt-1 text-sm text-navy-500">Tidak perlu kartu kredit, langsung bisa dipakai.</p> `);
			$$renderer.push(`<!--[-1--><form class="mt-6 flex flex-col gap-4">`);
			Input($$renderer, {
				label: "Nama",
				placeholder: "Nama kamu",
				required: true,
				autocomplete: "name",
				get value() {
					return name;
				},
				set value($$value) {
					name = $$value;
					$$settled = false;
				}
			});
			$$renderer.push(`<!----> `);
			Input($$renderer, {
				label: "Email",
				type: "email",
				placeholder: "nama@email.com",
				required: true,
				autocomplete: "email",
				get value() {
					return email;
				},
				set value($$value) {
					email = $$value;
					$$settled = false;
				}
			});
			$$renderer.push(`<!----> `);
			$$renderer.push("<!--[-1-->");
			$$renderer.push(`<!--]--> `);
			Button($$renderer, {
				type: "submit",
				loading: sending,
				fullWidth: true,
				children: ($$renderer) => {
					$$renderer.push(`<!---->Daftar Gratis`);
				},
				$$slots: { default: true }
			});
			$$renderer.push(`<!----></form> <div class="my-6 flex items-center gap-3 text-xs text-navy-400"><span class="h-px flex-1 bg-navy-100"></span> atau <span class="h-px flex-1 bg-navy-100"></span></div> `);
			Button($$renderer, {
				variant: "secondary",
				fullWidth: true,
