			$$renderer.push(`<!---->`);
			$$renderer.push(`<!--]--> <p class="mt-6 text-center text-sm text-navy-500">Sudah punya akun? <a href="/masuk" class="font-medium text-coral-500">Masuk</a></p>`);
		}
		do {
			$$settled = true;
			$$inner_renderer = $$renderer.copy();
			$$render_inner($$inner_renderer);
		} while (!$$settled);
		$$renderer.subsume($$inner_renderer);
	});
