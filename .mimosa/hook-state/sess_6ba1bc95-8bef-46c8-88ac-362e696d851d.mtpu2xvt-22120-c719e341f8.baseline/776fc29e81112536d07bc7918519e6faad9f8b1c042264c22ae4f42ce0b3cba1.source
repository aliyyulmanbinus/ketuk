import{B as e,E as t,I as n,_ as r,w as i}from"../chunks/BXjcv6Yd.js";import"../chunks/xihTtKlq.js";import"../chunks/CghUx4vQ.js";var a=t(`<meta name="description" content="Ketuk.id dibuat supaya urus acara — dari pernikahan sampai syukuran kantor — tidak perlu pindah-pindah aplikasi."/>`),o=t(`<section class="py-20"><div class="mx-auto max-w-3xl px-4 sm:px-6"><h1 class="font-display text-4xl font-bold text-navy-900">Tentang Ketuk.id</h1> <div class="mt-8 flex flex-col gap-5 text-navy-600"><p>Ketuk.id lahir dari pengamatan sederhana: mengurus satu acara — pernikahan, ulang tahun,
