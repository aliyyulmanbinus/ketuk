import { h as getEvent } from "../../../../../chunks/api.js";
import { error } from "@sveltejs/kit";
//#region src/routes/(app)/undangan/[id]/+layout.ts
var load = async ({ fetch, parent, params }) => {
	const { accessToken } = await parent();
	try {
		return { event: await getEvent(params.id, {
			fetch,
			accessToken
		}) };
	} catch {
		throw error(404, "Undangan tidak ditemukan");
	}
};
//#endregion
export { load };
