		$$renderer.push(`<!----></div> <dl class="grid gap-4 text-sm sm:grid-cols-2"><div><dt class="text-navy-400">Tanggal</dt> <dd class="text-navy-900">${escape_html(data.event.date ? formatEventDate(data.event.date) : "Belum diatur")}</dd></div> <div><dt class="text-navy-400">Lokasi</dt> <dd class="text-navy-900">${escape_html(data.event.venue ?? data.event.location ?? "Belum diatur")}</dd></div> <div><dt class="text-navy-400">Alamat undangan</dt> <dd class="text-navy-900">ketuk.id/${escape_html(data.event.slug)}</dd></div> <div><dt class="text-navy-400">Dilihat</dt> <dd class="text-navy-900">${escape_html(data.event.viewCount)}x</dd></div></dl></div> <div class="flex flex-col gap-3 rounded-xl border border-navy-100 bg-white p-6"><h2 class="font-display text-lg font-semibold text-navy-900">Aksi</h2> `);
		if (!data.event.isPublished) {
			$$renderer.push("<!--[0-->");
