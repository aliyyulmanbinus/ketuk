import { h as getEvent, m as listGiftProducts } from "../../../../../../chunks/api.js";
import { error } from "@sveltejs/kit";
//#region src/routes/(public)/[slug]/tamu/[guestSlug]/+page.server.ts
/**
* Tidak ada endpoint publik untuk ambil nama tamu asli dari guestSlug (lihat
* catatan di laporan tahap ini) — nama ditebak dengan un-slugify slug-nya.
* Cukup untuk sapaan personal di cover, tidak sepenuhnya akurat kalau nama
* aslinya punya kapitalisasi/karakter yang hilang saat di-slug-kan.
*/
function unslugify(slug) {
	return slug.split("-").filter(Boolean).map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
}
var load = async ({ fetch, params, setHeaders }) => {
	setHeaders({ "cache-control": "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400" });
	let event;
	try {
		event = await getEvent(params.slug, { fetch });
	} catch {
		throw error(404, "Undangan tidak ditemukan");
	}
	if (!event.isPublished) throw error(404, "Undangan tidak ditemukan");
	const giftProducts = await listGiftProducts(void 0, { fetch }).catch(() => []);
	return {
		event,
		giftProducts,
		guestSlug: params.guestSlug,
		guestName: unslugify(params.guestSlug)
	};
};
//#endregion
export { load };
