			$$renderer.push(`<!--[0--><div class="fixed inset-0 z-[110] flex items-center justify-center p-4"><button type="button" class="absolute inset-0 bg-navy-950/50" aria-label="Batal"></button> <div role="alertdialog" aria-modal="true" class="relative z-10 w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl"><h2 class="mb-2 font-display text-lg font-semibold text-navy-900">${escape_html(state().title)}</h2> <p class="mb-6 text-sm text-navy-600">${escape_html(state().message)}</p> <div class="flex justify-end gap-3">`);
