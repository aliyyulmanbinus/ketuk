			else $$renderer.push(`<!--[-1--><button type="button" role="tab"${attr("aria-selected", active === tab.value)}${attr_class(`whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-medium transition-colors ${active === tab.value ? "border-coral-500 text-navy-900" : "border-transparent text-navy-400 hover:text-navy-700"}`)}>${escape_html(tab.label)}</button>`);
