	},
	"dependencies": {
		"@hono/node-server": "latest",
		"@ketuk/shared": "workspace:*",
		"@supabase/supabase-js": "latest",
		"drizzle-orm": "latest",
		"hono": "latest",
		"postgres": "latest",
		"zod": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "latest",
		"drizzle-kit": "latest",
		"tsx": "latest",
		"typescript": "latest"
	}
}
