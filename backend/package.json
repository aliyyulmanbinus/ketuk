{
	"name": "backend",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
